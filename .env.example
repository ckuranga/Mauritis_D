# PostgreSQL connection (photos and videos are stored in this database)
POSTGRES_PASSWORD=replace-with-a-secret-value
POSTGRES_PASSWORD_URLENCODED=replace-with-url-encoded-secret
DATABASE_URL=postgresql://postgres:[REDACTED]@127.0.0.1:5432/app_db

# Public address of the site, used for sitemap, canonical links and sharing cards
SITE_URL=https://www.example.edu

# Long random string (32+ characters). Generate: openssl rand -base64 48
SESSION_SECRET=

# First administrator, created on first start only. Choose a strong password (12+ characters).
ADMIN_EMAIL=you@example.edu
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# Optional: largest video accepted, in megabytes (default 40)
MAX_VIDEO_MB=40

